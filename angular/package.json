{
  "name": "everton-canez-angular",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run generate:blog && ng serve",
    "build": "npm run generate:blog && ng build --base-href / && node scripts/create-gh-pages-fallback.mjs",
    "generate:blog": "node scripts/generate-blog-posts.mjs",
    "watch": "npm run generate:blog && ng build --watch --configuration development",
    "serve:ssr:everton-canez": "node dist/server/server.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.0",
    "sass": "^1.105.1",
    "typescript": "~6.0.0"
  }
}
